{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouterResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "confidence", "reason", "normalized_question"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["general_chat", "public_lookup", "browser_lookup"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string"
    },
    "normalized_question": {
      "type": "string"
    },
    "cache_hint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lookup_type": { "type": "string" },
        "target": { "type": "string" },
        "site": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "force_refresh": {
      "type": "boolean"
    }
  }
}
